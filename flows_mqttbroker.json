    {
        "id": "c6af5deaf9f1f04f",
        "type": "ui-template",
        "z": "ac4cb02db15fb728",
        "g": "386ca7890191d744",
        "group": "75b15bea3008a8a4",
        "page": "",
        "ui": "",
        "name": "Ansicht Multi Sensor",
        "order": 2,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<!-- STRUKTURELLER CONTAINER FÜR DASHBOARD 2.0 -->\n<div style=\"width: 100%; min-width: 400px; max-width: 800px; margin: 5px auto; display: flex; flex-direction: column; background-color: #f5f5f5; border: 1px solid #ccc; box-sizing: border-box;\">\n  \n  <!-- KARTEN-CONTAINER -->\n  <div style=\"width: 100%; height: 600px; position: relative; overflow: hidden; background-color: #f5f5f5;\">\n    \n    <!-- SAUBERES SVG OVERLAY -->\n    <!-- TIPPFEHLER BEI XMLNS KORRIGIERT: Zwingend erforderlich für korrektes SVG-Rendering -->\n    <svg xmlns=\"http://w3.org\" viewBox=\"0 0 800 600\" style=\"width: 100%; height: 100%; position: absolute; top: 0; left: 0; pointer-events: none; z-index: 2;\">\n      <defs>\n        <!-- Text-Hintergrundfilter -->\n        <filter x=\"-0.1\" y=\"-0.1\" width=\"1.2\" height=\"1.2\" id=\"bg-text\">\n          <feFlood flood-color=\"#111111\" flood-opacity=\"0.85\" />\n          <feComposite in=\"SourceGraphic\" operator=\"over\" />\n        </filter>\n      </defs>\n\n      <!-- HAUPT-WRAPPER (Verschiebung und Skalierung der Gesamtszene) -->\n      <g transform=\"translate(80, 120) scale(0.9)\">\n        \n        <!-- ========================================== -->\n        <!-- START: IHRE EIGENEN STRICHE UND WÄNDE     -->\n        <!-- ========================================== -->\n        <g id=\"mein-hintergrundplan\" style=\"pointer-events: auto;\">\n          \n          <!-- Ein dünner grauer Rahmen um das gesamte Spielfeld (640x480) -->\n          <!-- <rect x=\"0\" y=\"0\" width=\"640\" height=\"480\" fill=\"none\" stroke=\"#cccccc\" stroke-width=\"1\" />  -->\n          \n          <!-- BEISPIEL 1: Eine einfache gerade Wand (Strich) -->\n          <!-- x1/y1 ist der Startpunkt, x2/y2 der Endpunkt -->\n          <line x1=\"100\" y1=\"100\" x2=\"550\" y2=\"100\" stroke=\"#444444\" stroke-width=\"3\" />\n            <line x1=\"100\" y1=\"100\" x2=\"100\" y2=\"300\" stroke=\"#444444\" stroke-width=\"3\" />  \n            <line x1=\"100\" y1=\"300\" x2=\"350\" y2=\"300\" stroke=\"#444444\" stroke-width=\"3\" />\n              <line x1=\"350\" y1=\"300\" x2=\"450\" y2=\"400\" stroke=\"#444444\" stroke-width=\"3\" />\n              <line x1=\"450\" y1=\"400\" x2=\"550\" y2=\"300\" stroke=\"#444444\" stroke-width=\"3\" />\n                <line x1=\"550\" y1=\"300\" x2=\"550\" y2=\"100\" stroke=\"#444444\" stroke-width=\"3\" />\n          \n          <!-- BEISPIEL 2: Eine schräge Wand -->\n            <!--  <line x1=\"400\" y1=\"100\" x2=\"500\" y2=\"300\" stroke=\"#444444\" stroke-width=\"3\" stroke-dasharray=\"4,4\" /> -->\n          \n          <!-- BEISPIEL 3: Ein geschlossener Raum oder eine Verbotszone -->\n          <!-- fill=\"none\" macht das Innere durchsichtig, fill-opacity färbt es transparent ein -->\n          <!-- <rect x=\"100\" y=\"200\" width=\"150\" height=\"120\" fill=\"#007aff\" fill-opacity=\"0.05\" stroke=\"#007aff\" stroke-width=\"1.5\" /> -->\n          \n          <!-- BEISPIEL 4: Ein Text zur Beschriftung eines Raumes -->\n          <text x=\"120\" y=\"225\" fill=\"#666666\" font-family=\"sans-serif\" font-size=\"12\" font-weight=\"bold\">West</text>\n          <text x=\"500\" y=\"225\" fill=\"#666666\" font-family=\"sans-serif\" font-size=\"12\" font-weight=\"bold\">Ost</text>\n          <text x=\"300\" y=\"130\" fill=\"#666666\" font-family=\"sans-serif\" font-size=\"12\" font-weight=\"bold\">Nord</text>\n          <text x=\"300\" y=\"280\" fill=\"#666666\" font-family=\"sans-serif\" font-size=\"12\" font-weight=\"bold\">Süd</text>\n\n        </g>\n        <!-- ========================================== -->\n\n\n        <!-- SCHLEIFE ÜBER DIE RADAR-SENSOREN (Bleiben unverändert scharf) -->\n        <g v-if=\"msg && Array.isArray(msg.payload)\" v-for=\"(sensor, idx) in msg.payload\" :key=\"sensor.sensorid || idx\">\n          \n          <!-- 1. DYNAMISCHE SICHTKEULE -->\n          <path d=\"M 0 0 L -189 -109.38 A 218.75 218.75 0 0 1 189 -109.38 Z\" \n                :style=\"{ \n                  fill: sensor.targets && sensor.targets.length > 0 ? '#ff3b30' : '#b4b4b4', \n                  fillOpacity: sensor.targets && sensor.targets.length > 0 ? 0.25 : 0.12, \n                  stroke: sensor.targets && sensor.targets.length > 0 ? '#ff3b30' : '#888888', \n                  strokeWidth: '1.5px', \n                  strokeDasharray: sensor.targets && sensor.targets.length > 0 ? 'none' : '2,2', \n                  strokeOpacity: 0.6 \n                }\" \n                :transform=\"'translate(' + (sensor.offsetX || 0) + ',' + (sensor.offsetY || 0) + ') rotate(' + (sensor.winkel || 0) + ')'\" />\n\n          <!-- 2. SENSOR-ZENTRUM -->\n          <circle :cx=\"sensor.offsetX || 0\" :cy=\"sensor.offsetY || 0\" r=\"6\" style=\"fill: #ff9900; stroke: #ffffff; stroke-width: 1.5px;\" />\n\n          <!-- 3. SENSOR-ID UND BEZEICHNUNG -->\n          <g :transform=\"'translate(' + (sensor.offsetX || 0) + ',' + (sensor.offsetY || 0) + ')'\">\n            <text x=\"10\" y=\"2\" font-size=\"10\" font-family=\"sans-serif\" font-weight=\"bold\" filter=\"url(#bg-text)\" style=\"fill: #ff9900;\">\n              {{ sensor.sensorid }} ({{ sensor.winkel }}°)\n            </text>\n            <text x=\"10\" y=\"12\" font-size=\"8\" font-family=\"sans-serif\" font-weight=\"normal\" filter=\"url(#bg-text)\" style=\"fill: #aaaaaa;\">\n              {{ sensor.sensorBez }}\n            </text>\n          </g>\n\n          <!-- 4. TARGETS PRO SENSOR -->\n          <g v-for=\"(t, index) in sensor.targets\" :key=\"t.id || index\" :transform=\"'translate(' + t.x + ',' + t.y + ')'\">\n            <circle cx=\"0\" cy=\"0\" r=\"7\" style=\"fill: #ff3b30; stroke: #ffffff; stroke-width: 1.5px; pointer-events: auto;\" />\n            <text x=\"10\" y=\"4\" font-size=\"10\" font-family=\"sans-serif\" font-weight=\"bold\" filter=\"url(#bg-text)\" style=\"fill: #ff3b30;\">\n              ID:{{ t.id }} (s:{{ t.s }})\n            </text>\n          </g>\n\n        </g>\n      </g>\n    </svg>\n  </div>\n\n  <!-- STATUS-BALKEN -->\n  <div v-if=\"msg && Array.isArray(msg.payload)\"\n       :style=\"{ \n         width: '100%', padding: '8px 0', textAlign: 'center', fontWeight: 'bold', fontSize: '13px', color: '#ffffff', \n         backgroundColor: msg.payload.some(s => s.targets && s.targets.length > 0) ? '#ff3b30' : '#34c759' \n       }\">\n    {{ msg.payload.some(s => s.targets && s.targets.length > 0) ? '⚠️ TARGET ERKANNT' : '✅ BEREICH FREI' }}\n  </div>\n</div>\n",
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 760,
        "y": 880,
        "wires": [
            []
        ]
    },
