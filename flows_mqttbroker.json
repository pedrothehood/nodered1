    {
        "id": "9e948578b3fadfd2",
        "type": "function",
        "z": "ac4cb02db15fb728",
        "g": "2b7a740ef0bf598d",
        "name": "prepare-influx-input",
        "func": "// 1. InfluxDB v2 Konfiguration\nconst server = \"http://localhost:8086\";\nconst token = \"TBgaNg68u6XU3I7Zv47vPc8xjol4dmRey-PwA4ZwuOh9SObwnF3aNKHCJuNS7REvL9T-66X0EktiN5Vg1gzyGg==\";\nconst org = \"home\";\nconst bucket = \"radar_data\"; // Geändert auf deinen Wunsch\n\n// 2. Eingangsdaten prüfen\nconst data = msg.payload;\n\n// Bedingung 1: Nur senden, wenn occupancy gleich 1 ist\n// (Prüfung fängt sowohl die Zahl 1 als auch den String \"1\" ab)\nif (Number(data.occupancy) !== 1) {\n    node.status({ fill: \"grey\", shape: \"ring\", text: \"Ignoriert: occupancy nicht 1\" });\n    return null;\n}  \n\n// 3. Kleinstes 'd' (Distance) aus dem targets-Array ermitteln\nlet minD = Infinity;\n\nif (data.targets && data.targets.length > 0) {\n    for (const target of data.targets) {\n        if (target.d < minD) {\n            minD = target.d;\n        }\n    }\n}\n\n//if (minD === Infinity ) minD = 0;\n// Bedingung 2: Nur senden, wenn ein gültiges d > 0 gefunden wurde\nif (minD === Infinity || minD <= 0) {\n    node.status({ fill: \"grey\", shape: \"ring\", text: \"Ignoriert: kein target mit d > 0\" });\n    return null;\n} \n\n// 4. Line Protocol aufbauen (mit deinen exakten Bezeichnungen)\nconst measurement = \"radar_ev\";\n// Tags (Leerzeichen in sensorBez werden für InfluxDB automatisch mit Backslash maskiert)\nconst sauberBez = data.sensorBez.replace(/ /g, '\\\\ ');\nconst tags = `sensorid=${data.sensorid},sensorBez=${sauberBez}`;\n\n// Fields\nconst fields = `distancecm=${minD},occupancy=${data.occupancy}`;\n\n// Line Protocol String finalisieren\nconst lineProtocol = `${measurement},${tags} ${fields}`;\n\n// 5. HTTP-Request für die nachfolgende HTTP-Request-Node vorbereiten\nmsg.payload = lineProtocol;\nmsg.url = `${server}/api/v2/write?org=${org}&bucket=${bucket}&precision=s`;\nmsg.headers = {\n    \"Authorization\": `Token ${token}`,\n    \"Content-Type\": \"text/plain; charset=utf-8\"\n};\n\n// Status-Anzeige unter der Node in Node-RED aktualisieren\nnode.status({ fill: \"green\", shape: \"dot\", text: `Gesendet: d=${minD}` });\n\nreturn msg;\n",
