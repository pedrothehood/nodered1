    {
        "id": "8d46b411eec30899",
        "type": "ui-template",
        "z": "ac4cb02db15fb728",
        "group": "75b15bea3008a8a4",
        "page": "",
        "ui": "",
        "name": "Radar-Ansichtc",
        "order": 2,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<div style=\"width: 100%; min-width: 280px; max-width: 450px; height: 420px; margin: 5px auto; padding: 10px; position: relative; display: flex; flex-direction: column; justify-content: space-between;\">\n  \n  <!-- Das Koordinatensystem/Radar (Skala erweitert auf 6m) -->\n  <svg viewBox=\"0 0 100 125\" style=\"width: 100%; height: 350px; display: block; overflow: visible;\">\n    <defs>\n      <filter x=\"0\" y=\"0\" width=\"1\" height=\"1\" id=\"bg-text\">\n        <feFlood flood-color=\"var(--sys-bg-default, #111)\" flood-opacity=\"0.7\"/>\n        <feComposite in=\"SourceGraphic\" operator=\"over\"/>\n      </filter>\n    </defs>\n\n    <!-- Feste Hintergrundringe -->\n    <circle cx=\"50\" cy=\"125\" r=\"41.67\" fill=\"none\" stroke=\"var(--sys-border-subtle, #444)\" stroke-width=\"0.5\" stroke-dasharray=\"1,1\" />\n    <text x=\"50\" y=\"81.33\" fill=\"#000000\" font-size=\"4\" font-family=\"sans-serif\" font-weight=\"bold\" text-anchor=\"middle\">2m</text>\n\n    <circle cx=\"50\" cy=\"125\" r=\"83.33\" fill=\"none\" stroke=\"var(--sys-border-subtle, #444)\" stroke-width=\"0.5\" stroke-dasharray=\"1,1\" />\n    <text x=\"50\" y=\"39.67\" fill=\"#000000\" font-size=\"4\" font-family=\"sans-serif\" font-weight=\"bold\" text-anchor=\"middle\">4m</text>\n    \n    <circle cx=\"50\" cy=\"125\" r=\"125\" fill=\"none\" stroke=\"var(--sys-border-default, #666)\" stroke-width=\"0.8\" />\n    <text x=\"50\" y=\"-2\" fill=\"#000000\" font-size=\"4\" font-family=\"sans-serif\" font-weight=\"bold\" text-anchor=\"middle\">6m</text>\n    \n    <line x1=\"50\" y1=\"0\" x2=\"50\" y2=\"125\" stroke=\"var(--sys-border-subtle, #333)\" stroke-width=\"0.5\" />\n    <circle cx=\"50\" cy=\"125\" r=\"2.5\" fill=\"#ff9900\" />\n    <text x=\"54\" y=\"124\" fill=\"#ff9900\" font-size=\"4\" font-family=\"sans-serif\" font-weight=\"bold\">RD-03D</text>\n\n    <!-- Hier werden die Targets gezeichnet -->\n    <g v-for=\"t in msg.payload.targets\" :key=\"t.id\">\n      <g v-if=\"t.visible\">\n        <circle :cx=\"t.x\" :cy=\"t.y\" r=\"3\" fill=\"#00ff00\" stroke=\"#ffffff\" stroke-width=\"0.5\" />\n        <text :x=\"t.x + 4\" :y=\"t.y + 1\" fill=\"#00ff00\" font-size=\"4\" font-family=\"sans-serif\" font-weight=\"bold\" filter=\"url(#bg-text)\">\n          ID:{{t.id}} ({{t.s}})\n        </text>\n      </g>\n    </g>\n  </svg>\n\n  <!-- Auffälliges Signal-Banner -->\n  <div :style=\"{\n         width: '100%', \n         padding: '10px 0', \n         borderRadius: '6px', \n         textAlign: 'center', \n         fontWeight: 'bold', \n         fontSize: '16px',\n         color: '#ffffff',\n         letterSpacing: '1px',\n         transition: 'all 0.3s ease',\n         backgroundColor: msg.payload.alertStatus === 'ON' ? '#ff3b30' : '#34c759',\n         boxShadow: msg.payload.alertStatus === 'ON' ? '0 0 12px #ff3b30' : 'none'\n       }\">\n    {{ msg.payload.alertStatus === 'ON' ? '⚠️ TARGET ERKANNT (ON)' : '✅ BEREICH FREI (OFF)' }}\n  </div>\n\n</div>\n",
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 740,
        "y": 400,
        "wires": [
            []
        ]
    },
    {
        "id": "5413752d31c20cbe",
        "type": "function",
        "z": "ac4cb02db15fb728",
        "name": "Prozentumrechnung",
        "func": "const targets = msg.payload.targets || [];\nlet processedTargets = [];\n\nconst svgWidth = 100; // ca. 33% mehr Dehnung,  statt 100;\nconst svgHeight = 125;\nconst scale = svgHeight / 6000;\n\nconst targetMap = {};\nfor (let t of targets) {\n    targetMap[t.id] = t;\n}\n\n// Hilfsvariable für den geringsten Y-Abstand in mm (Start bei unendlich)\nlet minMillimeterY = Infinity; \n\nfor (let i = 0; i < 3; i++) {\n    let target = targetMap[i];\n    \n    if (target) {\n        let xPixel = 50 + (target.x * scale * 1.6); // x-Dehnfaktor\n        let yPixel = svgHeight - (target.y * scale);\n        \n        let xPercent = (xPixel / svgWidth) * 100;\n        let yPercent = (yPixel / svgHeight) * 100;\n        \n        // Finde das Target mit dem geringsten Abstand (target.y ist der echte mm-Wert)\n        if (target.y < minMillimeterY) {\n            minMillimeterY = target.y;\n        }\n\n        processedTargets.push({\n            id: i,\n            x: Number(xPixel.toFixed(2)),\n            y: Number(yPixel.toFixed(2)),\n            px: Number(xPercent.toFixed(2)),\n            py: Number(yPercent.toFixed(2)),\n            s: target.s ?? 0,\n            visible: true\n        });\n    } else {\n        processedTargets.push({\n            id: i,\n            visible: false\n        });\n    }\n}\n\n// Zonen-Logik basierend auf den echten Millimeter-Werten\nlet distZone = \"NONE\";\nlet minDist = 0;\n\nif (minMillimeterY !== Infinity) {\n    minDist = minMillimeterY; // Gibt den minimalen Abstand in mm aus\n    \n    if (minDist <= 2000) {\n        distZone = \"NEAR\";       // 0m bis 2m\n    } else if (minDist <= 4000) {\n        distZone = \"MEDIUM\";     // >2m bis 4m\n    } else {\n        distZone = \"FAR\";        // >4m bis 6m\n    }\n}\n\nmsg.payload = {\n    targets: processedTargets,\n    alertStatus: global.get(\"radar_target_alert\") || \"OFF\",\n    minDist: minDist, // minimaler Abstand in mm\n    distZone: distZone // \"NEAR\", \"MEDIUM\", \"FAR\" oder \"NONE\"\n};\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 280,
        "wires": [
            [
                "8d46b411eec30899",
                "73b9e7f2f78f62c1",
                "6b238684a9c91bdd"
            ]
        ]
    },
