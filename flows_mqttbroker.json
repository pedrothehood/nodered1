    {
        "id": "4fc37bba2a3c3d37",
        "type": "function",
        "z": "ac4cb02db15fb728",
        "name": "ON/OFF umwandeln",
        "func": "// Den Zustand (ON oder OFF) in den globalen Speicher schreiben\n// Wir wandeln den Text zur Sicherheit in Kleinbuchstaben um, falls \"On\" oder \"on\" gesendet wird.\nconst status = (msg.payload || \"\").toString().toLowerCase();\n\nif (status.includes(\"on\")) {\n    global.set(\"radar_target_alert\", \"ON\");\n} else {\n    global.set(\"radar_target_alert\", \"OFF\");\n}\n\nreturn msg; // Es muss hier nichts direkt weitergeleitet werden\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 440,
        "wires": [
            [
                "602ff015744490fe"
            ]
        ]
    },
