    {
        "id": "5ca5501de76f4c18",
        "type": "function",
        "z": "ac4cb02db15fb728",
        "g": "95ee46e3b6f68ca2",
        "name": "\"SensorConfig\" lesen/ergänzen ",
        "func": "// 1. Die sensorid aus der aktuellen Payload auslesen\nlet sensorId = msg.payload.sensorid;\n\n// 2. Den globalen Context \"sensorConfig\" abrufen\nlet sensorConfig = global.get(\"sensorConfig\") || {};\n\n// 3. Die passenden Sensordaten aus der Tabelle holen\nlet config = sensorConfig[sensorId];\n\n// 4. Wenn der Sensor in der Tabelle existiert, die Felder ergänzen\nif (config) {\n    msg.payload.offsetX = config.offsetX;\n    msg.payload.offsetY = config.offsetY;\n    msg.payload.winkel = config.winkel;\n    msg.payload.sensorBez = config.sensorBez;\n}\nmsg.payload.occupancy =  msg.payload.targets.length > 0 ? 1 : 0 ;\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 770,
        "y": 620,
