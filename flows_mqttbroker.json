    {
        "id": "aac8a163eefad152",
        "type": "function",
        "z": "ac4cb02db15fb728",
        "g": "185ad95e316c8f74",
        "name": "function 2",
        "func": "// Prüfen, ob die Payload ein Array ist\nif (Array.isArray(msg.payload)) {\n\n    // Das neue Zielobjekt initialisieren\n    let neueStruktur = {};\n\n    // Jedes Element aus dem Input-Array durchlaufen\n    msg.payload.forEach(item => {\n\n        // Den Sensor-Schlüssel dynamisch bestimmen (z.B. \"RD06D_05\" -> \"rd06d_05\")\n        // Falls der Schlüssel exakt so bleiben soll wie im Input, das .toLowerCase() einfach löschen\n        let sensorKey = item.sensorid ? item.sensorid.toLowerCase() : \"unbekannt\";\n\n        // Die exakte neue Feldstruktur mit korrekter Gross-/Kleinschreibung aufbauen\n        neueStruktur[sensorKey] = {\n            \"offsetX\": item.offsetx,\n            \"offsetY\": item.offsety,\n            \"winkel\": item.winkel,\n            \"sensorBez\": item.sensorbez\n        };\n    });\n    // 1. Die Struktur in der globalen Variable \"sensorConfig\" speichern\n    global.set(\"sensorConfig\", neueStruktur);\n    // Die transformierte Struktur an die Payload übergeben\n    msg.payload = neueStruktur;\n}\n\nreturn msg;",
