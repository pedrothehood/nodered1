    {
        "id": "2065c5acdab784c6",
        "type": "function",
        "z": "ac4cb02db15fb728",
        "g": "95ee46e3b6f68ca2",
        "name": "Ergänzen mit Sensorid",
        "func": "// 1. FEHLERSCHUTZ: Falls die Payload noch Text ist, in JSON umwandeln\nif (typeof msg.payload === \"string\") {\n    try {\n        msg.payload = JSON.parse(msg.payload);\n    } catch(e) {\n        node.error(\"Payload ist kein gültiges JSON: \" + msg.payload);\n        return msg;\n    }\n}\n\n// 2. Sensor-ID aus dem Topic holen\n// Falls msg.topic leer oder kein String ist, nutzen wir einen Fallback (\"unbekannt\")\nlet sensorId = \"unbekannt\";\nif (msg.topic && typeof msg.topic === \"string\") {\n    let topicParts = msg.topic.split('/');\n    // Filtert leere Einträge (falls das Topic mit / endet)\n    topicParts = topicParts.filter(part => part.length > 0); \n    if (topicParts.length > 0) {\n        sensorId = topicParts[topicParts.length - 1];\n    }\n}\n\n// 3. Sensor-ID in das Array einfügen\nif (Array.isArray(msg.payload)) {\n    msg.payload = msg.payload.map(item => {\n        if (typeof item === 'object' && item !== null) {\n            item.sensorid = sensorId; // Fügt das Feld direkt hinzu\n        }\n        return item;\n    });\n} else if (typeof msg.payload === 'object' && msg.payload !== null) {\n    // Falls es doch kein Array, sondern ein einzelnes Objekt ist\n    msg.payload.sensorid = sensorId;\n}\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 500,
        "y": 620,
