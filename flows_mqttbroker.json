    {
        "id": "84b5a61436c0abe5",
        "type": "function",
        "z": "ac4cb02db15fb728",
        "g": "386ca7890191d744",
        "name": "Umrechnung Offsets, Winkel",
        "func": "// ==================== KALIBRIERUNG ====================\n// MASSSTAB: Wie viele Pixel auf der Zeichnung entsprechen einer Sensor-Einheit?\n// Wenn der Sensor in cm misst und deine Zeichnung 800px breit ist, versuche z.B. 0.5 oder 0.2\nconst SCALE = 0.05; \n\n// SENSOR-URSPRUNG: Werkseitiger Mittelpunkt der Hardware (LD2410 Standard: X=50, Y=125)\nconst HARDWARE_CENTER_X = 50;\nconst HARDWARE_CENTER_Y = 125;\n// ======================================================\n\nlet incoming = msg.payload;\nif (typeof incoming === \"string\") {\n    try { incoming = JSON.parse(incoming); } catch(e) { return msg; }\n}\n\nlet offsetX = typeof incoming.offsetX === \"number\" ? incoming.offsetX : 0;\nlet offsetY = typeof incoming.offsetY === \"number\" ? incoming.offsetY : 0;\nlet winkel = typeof incoming.winkel === \"number\" ? incoming.winkel : 0;\n\nif (incoming.targets && Array.isArray(incoming.targets)) {\n    incoming.targets = incoming.targets.map(t => {\n        let alpha = winkel * Math.PI / 180;\n        //let d = Math.hypot(t.x, t.y);\n        // 1. Relativen Abstand zum Hardware-Nullpunkt berechnen\n        let relX = t.x - HARDWARE_CENTER_X;\n        let relY = HARDWARE_CENTER_Y - t.y; \n        \n        // 2. Den Massstab auf die relative Distanz anwenden (Skalierung)\n        relX = relX * SCALE;\n        relY = relY * SCALE;\n        \n        // 3. Rotationsmatrix anwenden (Winkel-Drehung)\n      //  let rotX = relX * Math.cos(alpha) + relY * Math.sin(alpha);\n      //  let rotY = -relX * Math.sin(alpha) +  relY * Math.cos(alpha);\n\n        // 3. Rotationsmatrix anwenden (Winkel-Drehung für dein System)\n      //  let rotX = relX * Math.cos(alpha) - relY * Math.sin(alpha);\n      //  let rotY = relX * Math.sin(alpha) + relY * Math.cos(alpha);\n\n        // 3. Rotationsmatrix anwenden (Perfekt abgestimmt auf dein System)\n        let rotX = relX * Math.cos(alpha) - relY * Math.sin(alpha);\n        let rotY = -relX * Math.sin(alpha) - relY * Math.cos(alpha);\n\n        // 4. Globale Position auf dem Hausplan (SVG-Pixel) berechnen\n        let finalX = offsetX + rotX;\n        let finalY = offsetY - rotY;\n\n        return {\n            id: t.id,\n            s: t.s,\n            d: t.d,\n            x: Math.round(finalX),\n            y: Math.round(finalY)\n        };\n    });\n}\n\nmsg.payload = incoming;\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
