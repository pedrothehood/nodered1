        "name": "function 3",
        "func": "// 2. Eingangsdaten prüfen\nconst data = msg.payload;\n\n// Bedingung 1: Nur senden, wenn occupancy gleich 1 ist\n// (Prüfung fängt sowohl die Zahl 1 als auch den String \"1\" ab)\nif (Number(data.occupancy) !== 1) {\n    node.status({ fill: \"grey\", shape: \"ring\", text: \"Ignoriert: occupancy nicht 1\" });\n    return null;\n}\n\n// 3. Kleinstes 'd' (Distance) aus dem targets-Array ermitteln\nlet minD = Infinity;\nif (data.targets && data.targets.length > 0) {\n    for (const target of data.targets) {\n        if (target.d < minD) {\n            minD = target.d;\n        }\n    }\n}\n\n// Bedingung 2: Nur senden, wenn ein gültiges d > 0 gefunden wurde\nif (minD === Infinity || minD <= 0) {\n    node.status({ fill: \"grey\", shape: \"ring\", text: \"Ignoriert: kein target mit d > 0\" });\n    return null;\n}\n\n// --- ÄNDERUNG HIER: Formatierung für den Telegram-Knoten ---\n// Wir verpacken den Text in das von Telegram erwartete Objekt\nmsg.payload = {\n    chatId: 8802727747,  // RECHTSCHREIB-WARNUNG: Das \"I\" bei chatId MUSS groß geschrieben sein!\n    type: \"message\",\n    content: `Sensor ${data.sensorid} ${data.sensorBez} meldet Bewegung mit ${minD}cm Distanz`\n};\nmsg.meinAlarmText = `Sensor ${data.sensorid} ${data.sensorBez} meldet Bewegung mit ${minD}cm Distanz`;\n// Status-Anzeige unter der Node in Node-RED aktualisieren\nnode.status({ fill: \"green\", shape: \"dot\", text: `Gesendet:${data.sensorid} d=${minD}` });\n\nreturn msg;\n",
